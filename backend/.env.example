# HireTrack Backend Environment Variables (Loco.rs + PostgreSQL)
# Copy this file to .env and fill in your local values.
# Never commit real credentials or secrets to version control.

# Active Loco environment (development, test, production)
LOCO_ENV=development

# Port where the Loco.rs backend API listens
SERVER_PORT=5150

# PostgreSQL connection string for development
DATABASE_URL=postgres://your_postgres_user:your_postgres_password@localhost:5432/hiretrack_development

# PostgreSQL connection string for automated tests
TEST_DATABASE_URL=postgres://your_postgres_user:your_postgres_password@localhost:5432/hiretrack_test

# Secret key placeholder for future authentication phases (replace with a long random string locally)
JWT_SECRET=replace_with_a_secure_random_secret

# Resume storage mode ("development" for local dev storage, "object_storage" in production)
STORAGE_MODE=development
# Public HTTPS base URL for production object storage (e.g. https://storage.example.com/hiretrack)
STORAGE_BASE_URL=http://localhost:5150/api/candidates/resumes
