# HireTrack Frontend Environment Variables
# Copy this file to .env and adjust values for your local machine.
# Never commit real secrets to version control.

# Display name shown in the application header
VITE_APP_NAME=HireTrack

# Base URL of the Loco.rs backend API
VITE_API_BASE_URL=http://localhost:5150/api

# Current environment label (development, staging, production)
VITE_APP_ENVIRONMENT=development
